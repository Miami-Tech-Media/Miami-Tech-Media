---
import { services } from '../../data/services';
import { primaryCta } from '../../data/nav';
---
<section class="services" id="services" aria-labelledby="services-heading">
  <div class="services-inner">
    <div class="services-intro">
      <p class="eyebrow">Services</p>
      <h2 id="services-heading">How We Can Help</h2>
      <div class="divider-accent" aria-hidden="true"></div>
      <p class="intro-lead">
        Good creative work starts with understanding what you&rsquo;re trying to accomplish.
      </p>
      <p class="intro-text">
        Whether you need help shaping the idea or bringing it to life, we work alongside you
        to create content that&rsquo;s clear, thoughtful, and built around what you actually need.
      </p>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-icon" aria-hidden="true">
            {service.icon === 'compass' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <polygon points="14.5 9.5 12.75 12.75 9.5 14.5 11.25 11.25 14.5 9.5" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 8.5a1.5 1.5 0 0 1 1.5-1.5h2l1-1.5h7l1 1.5h2A1.5 1.5 0 0 1 20 8.5v8A1.5 1.5 0 0 1 18.5 18h-13A1.5 1.5 0 0 1 4 16.5v-8Z" />
                <circle cx="12" cy="12.5" r="3.25" />
              </svg>
            )}
          </div>

          <div class="service-title-row">
            <span class="service-number" aria-hidden="true">{service.number}<span class="dot">&middot;</span></span>
            <h3>{service.title}</h3>
          </div>

          <p class="service-lead">{service.lead}</p>
          <p class="service-desc">{service.description}</p>

          <ul class="capabilities">
            {service.capabilities.map((capability) => (
              <li>{capability}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="services-cta">
      <div class="services-cta-copy">
        <span class="cta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
          </svg>
        </span>
        <p>
          <span class="cta-question">Have something in mind?</span>
          <span class="cta-answer">Let&rsquo;s talk.</span>
        </p>
      </div>

      <a
        href={primaryCta.href}
        target="_blank"
        rel="noopener"
        class="services-cta-btn"
        id="services-discovery-link"
      >
        Schedule a Discovery Call
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="cta-arrow">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Services CTA click tracking. Fires only on an intentional click,
  // does not preventDefault or delay navigation. No PII included.
  var servicesDiscoveryLink = document.getElementById('services-discovery-link');
  if (servicesDiscoveryLink) {
    servicesDiscoveryLink.addEventListener('click', function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'discovery_call_click', cta_location: 'services' });
    });
  }
</script>

<style>
  .services {
    background: var(--white);
  }

  .services-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5.5rem 3rem 6rem;
  }

  /* ── Intro ── */
  .services-intro {
    max-width: 640px;
    margin: 0 auto 3.25rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  h2 {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    color: var(--rich);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 1.35rem;
  }

  .divider-accent {
    width: 40px;
    height: 3px;
    background: var(--blue);
    border-radius: 2px;
    margin: 0 auto 1.75rem;
  }

  .intro-lead {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--rich);
    line-height: 1.6;
    margin: 0 0 0.6rem;
  }

  .intro-text {
    font-size: 0.98rem;
    color: var(--mid);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Service cards ── */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .service-card {
    background: #fff;
    border: 1px solid var(--gray);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .service-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.08);
    border-radius: 50%;
    color: var(--blue);
    margin-bottom: 1.5rem;
  }

  .service-icon svg {
    width: 24px;
    height: 24px;
  }

  .service-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .service-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--blue);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .service-number .dot {
    color: var(--gray);
    font-weight: 700;
  }

  .service-title-row h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--rich);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .service-lead {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--blue);
    line-height: 1.55;
    margin: 0 0 0.75rem;
  }

  .service-desc {
    font-size: 0.92rem;
    color: var(--mid);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .capabilities {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--gray);
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    column-gap: 0.9rem;
  }

  .capabilities li {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rich);
    position: relative;
    padding-right: 0.9rem;
  }

  .capabilities li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -0.55rem;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--blue);
  }

  /* ── Section CTA ── */
  .services-cta {
    background: var(--light);
    border: 1px solid var(--gray);
    border-radius: 16px;
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .services-cta-copy {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .cta-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-icon svg {
    width: 20px;
    height: 20px;
  }

  .services-cta-copy p {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }

  .cta-question {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--rich);
  }

  .cta-answer {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--blue);
  }

  .services-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    background: var(--blue);
    color: #fff;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .services-cta-btn:hover {
    opacity: 0.88;
  }

  .cta-arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .services-cta-btn:hover .cta-arrow {
    transform: translateX(2px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .services-inner {
      padding: 3.5rem 1.5rem 4rem;
    }

    .service-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .service-card {
      padding: 1.85rem 1.5rem;
    }

    .services-cta {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: 1.75rem 1.5rem;
    }

    .services-cta-copy {
      justify-content: center;
    }

    .services-cta-btn {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .services-cta-copy {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
