---
import { services } from '../../data/services';
---
<section class="services" id="services">
  <div class="services-inner">
    <div class="services-header">
      <p class="eyebrow">How We Help</p>
      <h2>A clearer brand. A stronger digital presence. A smarter way to create.</h2>
      <p class="lede">
        Miami Tech Media brings strategy, creative direction, and AI-assisted
        execution together in one lean partnership.
      </p>
    </div>

    <ul class="service-list">
      {services.map((service) => (
        <li class="service-row">
          <span class="service-number">{service.number}</span>
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p class="service-label">{service.label}</p>
            <p class="service-description">{service.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    padding: 6.5rem 3rem;
    background: var(--white);
  }

  .services-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .services-header {
    max-width: 640px;
    margin-bottom: 4.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(37, 99, 235, 0.07);
    border: 1px solid rgba(37, 99, 235, 0.14);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin: 0 0 1.25rem;
  }

  h2 {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 1.1rem;
  }

  .lede {
    font-size: 1.02rem;
    color: var(--mid);
    line-height: 1.7;
    margin: 0;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--gray);
  }

  .service-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2.5rem;
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--gray);
  }

  .service-number {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.02em;
    padding-top: 0.3rem;
  }

  .service-copy h3 {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .service-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--blue);
    margin: 0 0 0.9rem;
  }

  .service-description {
    font-size: 0.98rem;
    color: var(--mid);
    line-height: 1.7;
    max-width: 560px;
    margin: 0;
  }

  @media (max-width: 700px) {
    .services {
      padding: 4rem 1.5rem;
    }

    .services-header {
      margin-bottom: 3rem;
    }

    .service-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding: 2rem 0;
    }

    .service-number {
      padding-top: 0;
    }
  }
</style>
