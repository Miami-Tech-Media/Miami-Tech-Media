---
import { services } from '../../data/services';
---
<section class="services" id="services" aria-labelledby="services-heading">
  <div class="services-inner">
    <div class="services-intro">
      <p class="eyebrow">Services</p>
      <h2 id="services-heading">
        Strategic creative services built around clarity, trust, and growth<span class="accent-dot">.</span>
      </h2>
      <div class="divider-accent"></div>
      <p class="intro-text">
        From brand strategy to content systems, we help you communicate with clarity,
        consistency, and impact.
      </p>
      <a href="#final-cta" class="explore-link">
        Explore Our Services
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="link-arrow">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <ul class="service-list">
      {services.map((service) => (
        <li class="service-row">
          <span class="service-number" aria-hidden="true">{service.number}</span>
          <span class="row-divider" aria-hidden="true"></span>
          <div class="service-content">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="row-arrow">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--white);
  }

  .services-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3.5rem 3rem 5rem;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 6rem;
  }

  .services-intro {
    align-self: start;
    position: sticky;
    top: 7rem;
  }

  .eyebrow {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  h2 {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 700;
    color: var(--rich);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .accent-dot {
    color: var(--blue);
  }

  .divider-accent {
    width: 32px;
    height: 2px;
    background: var(--blue);
    margin: 0 0 1.75rem;
  }

  .intro-text {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .link-arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .explore-link:hover .link-arrow {
    transform: translateX(2px);
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--gray);
  }

  .service-row {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--gray);
  }

  .service-number {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--blue);
    line-height: 1;
    flex-shrink: 0;
    min-width: 52px;
  }

  .row-divider {
    width: 1px;
    align-self: stretch;
    background: var(--gray);
    flex-shrink: 0;
  }

  .service-content {
    flex: 1;
    min-width: 0;
  }

  .service-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--rich);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .service-content p {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0;
  }

  .row-arrow {
    width: 18px;
    height: 18px;
    color: var(--gray);
    flex-shrink: 0;
    margin-top: 0.15rem;
    transition: color 0.2s ease;
  }

  .service-row:hover .row-arrow {
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .services-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 1.5rem 3.5rem;
    }

    .services-intro {
      position: static;
    }
  }
</style>
