---
import { primaryCta } from '../../data/nav';
---
<section class="final-cta" id="final-cta">
  <div class="cta-inner">
    <div class="cta-copy">
      <h2>Let's Build Something That Moves Your Organization Forward.</h2>
      <p>
        Tell us what you're working on, where you're stuck, and what you want to
        accomplish. We'll explore whether Miami Tech Media is the right creative
        partner to help.
      </p>
    </div>

    <div class="cta-action">
      <a href={primaryCta.href} target="_blank" rel="noopener" class="cta-button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn-icon">
          <rect x="3.5" y="4.5" width="17" height="16" rx="2"/>
          <line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/>
          <line x1="7.5" y1="2.5" x2="7.5" y2="6.5"/>
          <line x1="16.5" y1="2.5" x2="16.5" y2="6.5"/>
        </svg>
        {primaryCta.label}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--rich);
    border-top: 1px solid rgba(248, 250, 252, 0.1);
  }

  .cta-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 3rem 7rem;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .cta-copy p {
    font-size: 1.05rem;
    color: rgba(248, 250, 252, 0.62);
    line-height: 1.65;
    max-width: 560px;
    margin: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background: var(--blue);
    color: #fff;
    padding: 1rem 1.5rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .cta-button:hover {
    opacity: 0.9;
  }

  @media (max-width: 900px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 4rem 1.5rem 4.5rem;
    }
  }
</style>
