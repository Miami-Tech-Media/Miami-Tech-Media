---
import { projects } from '../../data/projects';
---
<section class="featured-work" id="work">
  <div class="work-inner">
    <div class="work-header">
      <div class="work-header-text">
        <p class="eyebrow">Selected Work</p>
        <h2>Creative work built around trust, clarity, and community.</h2>
      </div>
      <a href="#work" class="view-all">View All Projects →</a>
    </div>

    <div class="work-grid">
      {projects.map((project) => (
        <article class="work-card">
          <div class="work-visual" data-style={project.visualStyle}>
            {project.visualStyle === 'lines' ? (
              <svg viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                <rect width="480" height="320" fill="var(--rich)" />
                {Array.from({ length: 14 }).map((_, i) => (
                  <line
                    x1={-60 + i * 45}
                    y1="340"
                    x2={140 + i * 45}
                    y2="-20"
                    stroke="rgba(255,255,255,0.06)"
                    stroke-width="1"
                  />
                ))}
                <circle cx="380" cy="70" r="46" fill="var(--cyan)" opacity="0.14" />
                <circle cx="380" cy="70" r="4" fill="var(--cyan)" />
                <text
                  x="34"
                  y="255"
                  font-family="'General Sans', sans-serif"
                  font-size="120"
                  font-weight="700"
                  fill="rgba(255,255,255,0.05)"
                >MTW</text>
              </svg>
            ) : (
              <svg viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                <rect width="480" height="320" fill="var(--rich)" />
                {Array.from({ length: 8 }).map((_, row) =>
                  Array.from({ length: 12 }).map((_, col) => (
                    <circle
                      cx={20 + col * 42}
                      cy={20 + row * 42}
                      r="2.4"
                      fill="rgba(255,255,255,0.08)"
                    />
                  ))
                )}
                <rect x="300" y="40" width="130" height="130" rx="20" fill="var(--blue)" opacity="0.16" />
                <rect x="300" y="40" width="130" height="130" rx="20" fill="none" stroke="var(--cyan)" stroke-width="1.5" opacity="0.5" />
                <text
                  x="34"
                  y="255"
                  font-family="'General Sans', sans-serif"
                  font-size="120"
                  font-weight="700"
                  fill="rgba(255,255,255,0.05)"
                >RM</text>
              </svg>
            )}
          </div>

          <div class="work-copy">
            <p class="work-client">{project.client}</p>
            <h3>{project.title}</h3>
            <p class="work-description">{project.description}</p>
            <a href="#work" class="view-project">View Project →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured-work {
    padding: 6.5rem 3rem;
    background: var(--white);
    border-top: 1px solid var(--gray);
  }

  .work-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .work-header-text {
    max-width: 640px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(37, 99, 235, 0.07);
    border: 1px solid rgba(37, 99, 235, 0.14);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin: 0 0 1.25rem;
  }

  h2 {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  .view-all {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.35rem;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .work-card {
    border: 1px solid var(--gray);
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
  }

  .work-visual {
    width: 100%;
    aspect-ratio: 3 / 2;
    line-height: 0;
  }

  .work-visual svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .work-copy {
    padding: 2.25rem 2rem 2.5rem;
  }

  .work-client {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0 0 0.65rem;
  }

  .work-copy h3 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.01em;
    margin: 0 0 0.85rem;
  }

  .work-description {
    font-size: 0.98rem;
    color: var(--mid);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .view-project {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
  }

  .view-project:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .featured-work {
      padding: 4rem 1.5rem;
    }

    .work-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .work-copy {
      padding: 1.85rem 1.5rem 2rem;
    }
  }
</style>
