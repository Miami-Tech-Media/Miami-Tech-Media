---
import { partners } from '../../data/partners';
---
<section class="trusted-by" id="trusted-by">
  <div class="trusted-inner">
    <div class="trusted-intro">
      <p class="eyebrow">Trusted By</p>
      <p class="intro-text">
        Organizations across technology, innovation, education, and community development.
      </p>
    </div>

    <ul class="partner-list">
      {partners.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trusted-by {
    background: var(--white);
    border-top: 1px solid var(--gray);
    border-bottom: 1px solid var(--gray);
  }

  .trusted-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.25rem 3rem 2.75rem;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .intro-text {
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }

  .partner-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .partner-list li {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mid);
  }

  @media (max-width: 900px) {
    .trusted-inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 2rem 1.5rem 2.25rem;
    }
  }
</style>
