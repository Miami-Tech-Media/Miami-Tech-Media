---
import { partners } from '../../data/partners';
---
<section class="trusted-by" id="trusted-by">
  <div class="trusted-inner">
    <p class="trust-statement">Trusted by</p>

    <ul class="logo-row">
      {partners.map((partner) => (
        <li class:list={['logo-item', `logo-${partner.slug}`]}>
          <img
            src={partner.file}
            alt={partner.name}
            width={partner.width}
            height={partner.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trusted-by {
    /* Approved section-specific background (Aug 2026): #F1F5FA creates
       clearer separation from the Services section below. Does not
       exactly match an existing token (--light is #F1F5F9), so it is
       scoped to this component rather than added to tokens.css or
       reusing a near-match token. */
    background: #F1F5FA;
    border-top: 1px solid var(--gray);
    border-bottom: 1px solid var(--gray);
  }

  .trusted-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.25rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .trust-statement {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    max-width: 30ch;
  }

  /* Desktop: compact single horizontal row, centered,
     subtle vertical dividers, no forced equal widths */
  .logo-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    width: 100%;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2.25rem;
    position: relative;
  }

  .logo-item:first-child {
    padding-left: 0;
  }

  .logo-item:not(:first-child)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 28px;
    background: var(--gray);
  }

  /* Rich Navy PNGs are used directly - CSS controls only size,
     position, and spacing. No mask, filter, or recolor here. */
  .logo-item img {
    display: block;
    height: 26px;
    width: auto;
    max-width: 140px;
  }

  /* Optical balance: preserve proportions, but rein in Atomic's very
     wide wordmark so it doesn't dominate the row, and give Miami Tech
     Works and Elevate Capital a slight size increase so their
     perceived visual weight matches the surrounding logos. */
  .logo-atomic-vc img {
    height: auto;
    max-width: 150px;
  }

  .logo-miami-tech-works img {
    height: 31px;
  }

  .logo-elevate-capital img {
    height: 36px;
  }

  /* Tablet / mobile: 2-column grid, Atomic VC reordered to a
     final centered full-width row. CSS `order` only - DOM order
     above is left untouched.
     Breakpoint widened from 900px to 1099px: the fixed-width
     desktop no-wrap row only clears the viewport without
     overflow starting at ~1075px, so 900-1074px previously
     caused horizontal overflow. Reusing the existing, already
     visually-balanced grid for that range removes the overflow
     without introducing new layout or shrinking logos further. */
  @media (max-width: 1099px) {
    .trusted-inner {
      padding: 2rem 1.5rem;
      gap: 1.25rem;
    }

    .trust-statement {
      max-width: 22ch;
    }

    .logo-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-items: center;
      align-items: center;
      row-gap: 1.5rem;
      column-gap: 1rem;
      width: 100%;
    }

    /* Remove the desktop dividers; not needed in a stacked grid. */
    .logo-item::before {
      display: none;
    }

    .logo-item {
      padding-left: 0;
    }

    /* Row 1 */
    .logo-miami-tech-works { order: 1; }
    .logo-refresh-miami    { order: 2; }
    /* Row 2 */
    .logo-miami-dade-college { order: 3; }
    .logo-elevate-capital    { order: 4; }
    /* Row 3 */
    .logo-keyfactor   { order: 5; }
    .logo-united-way  { order: 6; }
    /* Final row: centered, spanning both columns */
    .logo-atomic-vc {
      order: 7;
      grid-column: 1 / -1;
    }

    .logo-item img {
      height: 22px;
      max-width: 120px;
    }

    /* Atomic VC sits alone on its own full-width row, but its very
       wide wordmark (the widest aspect ratio in the set) was reading
       as the dominant element on mobile even there - reduced so it
       no longer pulls focus from the rest of the row. */
    .logo-atomic-vc img {
      height: auto;
      max-width: 110px;
    }

    /* Keyfactor's wordmark ran visually heavier than its neighbors
       at the base mobile size - trimmed moderately. */
    .logo-keyfactor img {
      height: 18px;
    }

    /* United Way's compact circular mark was reading as noticeably
       smaller than the surrounding wordmarks at the base size -
       increased so its visual footprint feels comparable. */
    .logo-united-way img {
      height: 32px;
    }

    .logo-miami-tech-works img {
      height: 27px;
    }

    .logo-elevate-capital img {
      height: 32px;
    }
  }
</style>
