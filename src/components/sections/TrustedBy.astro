---
import { partners } from '../../data/partners';
---
<section class="trusted-by" id="trusted-by">
  <div class="trusted-inner">
    <p class="trust-statement">Trusted by organizations building what&rsquo;s next</p>

    <ul class="logo-row">
      {partners.map((partner) => (
        <li class:list={['logo-item', `logo-${partner.slug}`]}>
          <img
            src={partner.file}
            alt={partner.name}
            width={partner.width}
            height={partner.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trusted-by {
    background: var(--white);
    border-top: 1px solid var(--gray);
    border-bottom: 1px solid var(--gray);
  }

  .trusted-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.25rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .trust-statement {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    max-width: 30ch;
  }

  /* Desktop: compact single horizontal row, centered,
     subtle vertical dividers, no forced equal widths */
  .logo-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    width: 100%;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2.25rem;
    position: relative;
  }

  .logo-item:first-child {
    padding-left: 0;
  }

  .logo-item:not(:first-child)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 28px;
    background: var(--gray);
  }

  .logo-item img {
    display: block;
    height: 26px;
    width: auto;
    max-width: 140px;
  }

  /* Optical balance per the approved logo pack: preserve proportions,
     but rein in the widest wordmarks so no single logo dominates the
     row, and give the near-square mark a touch more height so it
     doesn't read as tiny next to the wordmarks. */
  .logo-atomic-vc img,
  .logo-keyfactor img {
    height: auto;
    max-width: 108px;
  }

  .logo-elevate-capital img {
    height: 32px;
  }

  /* Tablet / mobile: 2-column grid, Atomic VC reordered to a
     final centered full-width row. CSS `order` only - DOM order
     above is left untouched. */
  @media (max-width: 900px) {
    .trusted-inner {
      padding: 2rem 1.5rem;
      gap: 1.25rem;
    }

    .trust-statement {
      max-width: 22ch;
    }

    .logo-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-items: center;
      align-items: center;
      row-gap: 1.5rem;
      column-gap: 1rem;
      width: 100%;
    }

    /* Remove the desktop dividers; not needed in a stacked grid. */
    .logo-item::before {
      display: none;
    }

    .logo-item {
      padding-left: 0;
    }

    /* Row 1 */
    .logo-miami-tech-works { order: 1; }
    .logo-refresh-miami    { order: 2; }
    /* Row 2 */
    .logo-miami-dade-college { order: 3; }
    .logo-elevate-capital    { order: 4; }
    /* Row 3 */
    .logo-keyfactor   { order: 5; }
    .logo-united-way  { order: 6; }
    /* Final row: centered, spanning both columns */
    .logo-atomic-vc {
      order: 7;
      grid-column: 1 / -1;
    }

    .logo-item img {
      height: 22px;
      max-width: 120px;
    }

    .logo-atomic-vc img {
      height: auto;
      max-width: 96px;
    }

    .logo-elevate-capital img {
      height: 26px;
    }
  }
</style>
