---
---
<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about-inner">
    <div class="about-copy">
      <p class="eyebrow">About Miami Tech Media</p>
      <h2 id="about-heading">A Strategic Creative Partner for the Miami Tech Community</h2>
      <div class="about-body">
        <p>
          Miami Tech Media helps technology companies, startups, innovation organizations,
          and mission-driven businesses communicate clearly, build trust, and strengthen
          their digital presence.
        </p>
        <p>
          Founded by Jorge, Miami Tech Media combines creative strategy, storytelling,
          design, content, and AI-assisted workflows with years of experience working
          alongside organizations in the technology and innovation community.
        </p>
      </div>
    </div>

    <div class="about-media" role="img" aria-label="Placeholder — approved photography pending">
      <div class="media-scrim"></div>
      <p class="media-note">Photography pending</p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--rich);
    overflow: hidden;
  }

  .about-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 560px;
  }

  .about-copy {
    padding: 5rem 0;
  }

  .eyebrow {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-body p {
    font-size: 1rem;
    color: rgba(248, 250, 252, 0.62);
    line-height: 1.7;
    margin: 0;
  }

  /* Temporary placeholder standing in for the approved About photography.
     Not hotlinked from any external source; to be replaced once a real,
     approved, self-hosted asset is supplied. */
  .about-media {
    position: relative;
    height: 400px;
    background: linear-gradient(160deg, #1e293b 0%, var(--rich) 70%);
    border: 1px solid rgba(248, 250, 252, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(15, 23, 42, 0.3), transparent);
  }

  .media-note {
    position: relative;
    z-index: 1;
    color: rgba(248, 250, 252, 0.5);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 1.5rem;
      min-height: 0;
    }

    .about-copy {
      padding: 3.5rem 0 2.5rem;
    }

    .about-media {
      height: 320px;
      margin: 0 -1.5rem;
    }
  }
</style>
