---
---
<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about-inner">
    <div class="about-copy">
      <p class="eyebrow">About Miami Tech Media</p>
      <h2 id="about-heading">A Strategic Creative Partner for the Miami Tech Community</h2>
      <div class="about-body">
        <p>
          Miami Tech Media helps technology companies, startups, innovation organizations,
          and mission-driven businesses communicate clearly, build trust, and strengthen
          their digital presence.
        </p>
        <p>
          Founded by Jorge, Miami Tech Media combines creative strategy, storytelling,
          design, content, and AI-assisted workflows with years of experience working
          alongside organizations in the technology and innovation community.
        </p>
      </div>
    </div>

    <div class="about-media">
      <picture>
        <source srcset="/images/jorge-founder-portrait.avif" type="image/avif" />
        <source srcset="/images/jorge-founder-portrait.webp" type="image/webp" />
        <img
          src="/images/jorge-founder-portrait.webp"
          alt="Jorge, founder and creative director of Miami Tech Media, in a modern workspace."
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--white);
    overflow: hidden;
  }

  .about-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 560px;
  }

  .about-copy {
    padding: 5rem 0;
  }

  .eyebrow {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 700;
    color: var(--rich);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-body p {
    font-size: 1rem;
    color: var(--mid);
    line-height: 1.7;
    margin: 0;
  }

  /* Approved founder portrait, shown at its full intrinsic composition
     - no cropping. Border preserved for definition against the light
     background; no border-radius was present before, none added now. */
  .about-media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--gray);
  }

  .about-media picture {
    display: block;
  }

  .about-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 1.5rem;
      min-height: 0;
    }

    .about-copy {
      padding: 3.5rem 0 2.5rem;
    }

    .about-media {
      margin: 0 -1.5rem;
    }
  }
</style>
