---
import { values } from '../../data/values';
---
<section class="about" id="about">
  <div class="about-inner">
    <div class="about-left">
      <p class="eyebrow">Why Miami Tech Media</p>
      <h2>A strategic partner without the agency machinery.</h2>
    </div>

    <div class="about-right">
      <p class="body-copy">
        Miami Tech Media works closely with each client to bring strategy,
        creativity, and execution into one clear process.
      </p>
      <p class="body-copy">
        You work directly with the founder and creative director, supported by
        AI-assisted workflows that make the process faster, leaner, and easier
        to maintain.
      </p>

      <ul class="value-list">
        {values.map((value) => (
          <li class="value-block">
            <h3>{value.title}</h3>
            <p>{value.supportingCopy}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6.5rem 3rem;
    background: var(--white);
    border-top: 1px solid var(--gray);
  }

  .about-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(37, 99, 235, 0.07);
    border: 1px solid rgba(37, 99, 235, 0.14);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin: 0 0 1.25rem;
  }

  .about-left h2 {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
    max-width: 380px;
  }

  .about-right {
    display: flex;
    flex-direction: column;
  }

  .body-copy {
    font-size: 1.02rem;
    color: var(--mid);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 0 1.35rem;
  }

  .body-copy:last-of-type {
    margin-bottom: 3rem;
  }

  .value-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .value-block {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--gray);
    border-radius: 14px;
  }

  .value-block h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--rich);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .value-block p {
    font-size: 0.9rem;
    color: var(--mid);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .about {
      padding: 4rem 1.5rem;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .about-left h2 {
      max-width: none;
    }

    .value-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .body-copy:last-of-type {
      margin-bottom: 2rem;
    }
  }
</style>
