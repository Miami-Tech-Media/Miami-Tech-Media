---
import { primaryCta } from '../../data/nav';
---
<section class="hero">
  <picture class="hero-media">
    <source srcset="/images/hero.avif" type="image/avif" />
    <img
      src="/images/hero.webp"
      alt="Technology professionals collaborating outdoors at a Miami waterfront setting"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero-gradient"></div>
  <div class="hero-vignette"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Building the Miami Tech Community</p>

      <h1>
        Helping the Organizations Building Miami Grow
      </h1>

      <p class="hero-subhead">
        We partner with technology companies and mission-driven organizations to communicate clearly, build trust, and grow through creative strategy and content production.
      </p>

      <div class="hero-actions">
        <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn-icon">
            <rect x="3.5" y="4.5" width="17" height="16" rx="2"/>
            <line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/>
            <line x1="7.5" y1="2.5" x2="7.5" y2="6.5"/>
            <line x1="16.5" y1="2.5" x2="16.5" y2="6.5"/>
          </svg>
          Let's Talk
        </a>
        <a href="#services" class="btn-secondary">
          Explore Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <p class="hero-trust">A strategic creative partner with deep roots in the Miami tech ecosystem and a growing presence in Orlando.</p>
    </div>
  </div>
</section>

<script>
  // Discovery Call click tracking - unchanged. Fires only on an
  // intentional click, does not preventDefault or delay navigation.
  const heroCta = document.querySelector('.hero .btn-primary');
  if (heroCta) {
    heroCta.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'discovery_call_click', cta_location: 'hero' });
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 600px;
    display: flex;
    align-items: center;
    background: var(--rich);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% bottom;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15, 23, 42, 0.88) 0%,
      rgba(15, 23, 42, 0.74) 28%,
      rgba(15, 23, 42, 0.36) 48%,
      rgba(15, 23, 42, 0.09) 65%,
      transparent 80%
    );
  }

  .hero-vignette {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.2), transparent);
  }

  .hero-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .hero-copy {
    max-width: 570px;
  }

  .hero-eyebrow {
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.13;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem;
  }

  .hero-subhead {
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.625;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .hero-trust {
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    max-width: 460px;
    margin: 1.5rem 0 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: #fff;
    padding: 0.875rem 1.5rem;
    border-radius: 6px;
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: var(--type-button-size);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.94);
    padding: 0.875rem 0.5rem;
    font-family: 'General Sans', system-ui, sans-serif;
    font-size: var(--type-button-size);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover {
    color: #fff;
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(2px);
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 700px;
    }

    .hero-media img {
      object-position: center bottom;
    }

    .hero-inner {
      padding: 6rem 2.5rem;
    }

    h1 {
      font-size: 2.6rem;
    }

    .hero-subhead {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1280px) {
    h1 {
      font-size: 2.8rem;
    }
  }
</style>
