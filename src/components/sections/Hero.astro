---
import { trustedLogos } from '../../data/trustedLogos';
import { primaryCta } from '../../data/nav';

const capabilities = [
  'Brand Strategy',
  'Website Strategy',
  'Content Systems',
  'AI Workflows',
];
---
<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <p class="eyebrow">AI-Powered Creative Studio · Miami, FL</p>

      <h1>Building the Miami tech community through media, marketing &amp; AI.</h1>

      <p class="lede">
        Miami Tech Media helps technology companies, innovation organizations, and
        community builders communicate more clearly through branding, websites,
        content, and AI.
      </p>

      <div class="hero-actions">
        <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-primary">
          Schedule a Discovery Call
        </a>
        <a href="#services" class="btn-secondary">Explore Services</a>
      </div>

      <div class="trusted-by">
        <p class="trusted-label">Trusted by</p>
        <ul class="trusted-logos">
          {trustedLogos.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero-panel">
      <p class="panel-label">What We Do</p>
      <ul class="capability-list">
        {capabilities.map((item) => (
          <li>
            <span class="capability-dot"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 6rem 3rem;
    background: var(--white);
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 6px;
    background: rgba(37, 99, 235, 0.07);
    border: 1px solid rgba(37, 99, 235, 0.14);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
  }

  h1 {
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    font-weight: 700;
    color: var(--rich);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .lede {
    font-size: 1.05rem;
    color: var(--mid);
    line-height: 1.7;
    max-width: 480px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--blue);
    color: #fff;
    padding: 0.85rem 1.9rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.87;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: var(--blue);
    border: 1.5px solid var(--blue);
    padding: 0.8rem 1.75rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn-secondary:hover {
    background: var(--blue);
    color: #fff;
  }

  .trusted-by {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gray);
  }

  .trusted-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0 0 1rem;
  }

  .trusted-logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
  }

  .trusted-logos li {
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--gray);
    border-radius: 6px;
  }

  .hero-panel {
    background: var(--rich);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    box-shadow: 0 20px 60px -30px rgba(15, 23, 42, 0.4);
  }

  .panel-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--cyan);
    margin: 0 0 1.75rem;
  }

  .capability-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .capability-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: #fff;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .capability-list li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .capability-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 3.5rem 1.5rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-panel {
      padding: 2.25rem 1.75rem;
    }
  }
</style>
