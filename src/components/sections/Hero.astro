---
import { trustedLogos } from '../../data/trustedLogos';
import { primaryCta } from '../../data/nav';
---
<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img
      src="/images/hero.webp"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content">
    <h1>Building the Miami tech community through media, marketing &amp; AI.</h1>

    <p class="lede">
      Miami Tech Media helps technology companies, innovation organizations, and
      community builders communicate more clearly through branding, websites,
      content, and AI.
    </p>

    <div class="hero-actions">
      <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-primary">
        Schedule a Discovery Call
      </a>
      <a href="#services" class="btn-secondary">Explore Services</a>
    </div>
  </div>

  <div class="hero-trust">
    <p class="trusted-label">Trusted by</p>
    <ul class="trusted-logos">
      {trustedLogos.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    color: #fff;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% center;
    display: block;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(15, 23, 42, 0.57) 0%,
        rgba(15, 23, 42, 0.41) 34%,
        rgba(15, 23, 42, 0.13) 60%,
        rgba(15, 23, 42, 0) 74%
      ),
      linear-gradient(
        180deg,
        rgba(15, 23, 42, 0.28) 0%,
        rgba(15, 23, 42, 0) 24%,
        rgba(15, 23, 42, 0) 68%,
        rgba(15, 23, 42, 0.38) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    max-width: 720px;
    padding: 7.5rem 3rem 2.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 3.8vw, 3.35rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0;
    text-shadow: 0 2px 18px rgba(15, 23, 42, 0.28);
  }

  .lede {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.7;
    max-width: 480px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--blue);
    color: #fff;
    padding: 0.85rem 1.9rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.65);
    padding: 0.8rem 1.75rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn-secondary:hover {
    background: #fff;
    color: var(--rich);
    border-color: #fff;
  }

  .hero-trust {
    position: relative;
    z-index: 1;
    padding: 1.5rem 3rem 2.25rem;
  }

  .trusted-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1rem;
  }

  .trusted-logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.5rem;
    margin: 0;
    padding: 0;
  }

  .trusted-logos li {
    font-size: 0.86rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
    text-shadow: 0 1px 4px rgba(15, 23, 42, 0.3);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 68vh;
    }

    .hero-media img {
      object-position: 88% 12%;
    }

    .hero-scrim {
      background:
        linear-gradient(
          180deg,
          rgba(15, 23, 42, 0.38) 0%,
          rgba(15, 23, 42, 0.21) 30%,
          rgba(15, 23, 42, 0.32) 68%,
          rgba(15, 23, 42, 0.52) 100%
        ),
        linear-gradient(
          90deg,
          rgba(15, 23, 42, 0.38) 0%,
          rgba(15, 23, 42, 0.18) 55%,
          rgba(15, 23, 42, 0.07) 100%
        );
    }

    .hero-content {
      padding: 6.5rem 1.5rem 1.75rem;
      max-width: 340px;
    }

    .hero-trust {
      padding: 1.15rem 1.5rem 1.75rem;
    }
  }
</style>
