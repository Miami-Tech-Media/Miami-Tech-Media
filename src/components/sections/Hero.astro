---
import { primaryCta } from '../../data/nav';
---
<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1>
        Helping Technology Organizations Tell Better Stories, Build Trust, and Grow<span class="accent-dot">.</span>
      </h1>

      <p class="hero-subhead">
        Building the Miami Tech Community Through Media, Marketing &amp; AI.
      </p>

      <div class="hero-actions">
        <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn-icon">
            <rect x="3.5" y="4.5" width="17" height="16" rx="2"/>
            <line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/>
            <line x1="7.5" y1="2.5" x2="7.5" y2="6.5"/>
            <line x1="16.5" y1="2.5" x2="16.5" y2="6.5"/>
          </svg>
          {primaryCta.label}
        </a>
        <a href="#services" class="btn-secondary">
          Explore Our Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-media">
      <picture>
        <source srcset="/images/hero.avif" type="image/avif" />
        <img
          src="/images/hero.webp"
          alt="Technology professionals collaborating outdoors at a Miami waterfront setting"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="hero-media-scrim"></div>
    </div>
  </div>
</section>

<script>
  // Discovery Call click tracking. Fires only on an intentional click,
  // does not preventDefault or delay navigation - the link's normal
  // target="_blank" navigation proceeds unchanged. No PII included.
  const heroCta = document.querySelector('.hero .btn-primary');
  if (heroCta) {
    heroCta.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'discovery_call_click', cta_location: 'hero' });
    });
  }
</script>

<style>
  .hero {
    background: var(--white);
    overflow: hidden;
  }

  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 3rem 6rem;
    display: grid;
    grid-template-columns: 1fr 500px;
    gap: 4rem;
    align-items: center;
  }

  .hero-copy {
    max-width: 620px;
  }

  h1 {
    font-size: clamp(2.25rem, 4vw, 4rem);
    font-weight: 700;
    color: var(--rich);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .accent-dot {
    color: var(--blue);
  }

  .hero-subhead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 500;
    color: var(--slate);
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--blue);
    color: #fff;
    padding: 0.9rem 1.6rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: var(--rich);
    padding: 0.9rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover {
    color: var(--blue);
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(2px);
  }

  .hero-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--gray);
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.1), transparent);
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3.5rem 2rem 3.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero-inner {
      padding: 3rem 1.5rem 3rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .btn-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
