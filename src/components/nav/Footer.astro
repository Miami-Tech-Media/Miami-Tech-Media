---
import { logoLines, navLinks } from '../../data/nav';
import { socialLinks, legalLinks, footerTagline, servingText, copyrightText } from '../../data/social';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label="Miami Tech Media home">
        {logoLines.map((line) => (
          <span class="logo-line">{line}</span>
        ))}
      </a>
      <p class="tagline">{footerTagline}</p>
      <div class="social-icons">
        {socialLinks.map((social) => (
          <a href={social.href} aria-label={social.label} class="social-icon">
            {social.label === 'LinkedIn' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <p class="footer-heading">Menu</p>
      {navLinks.map((link) => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </nav>

    <div class="footer-col">
      <p class="footer-heading">Serving</p>
      <p class="serving-text">{servingText}</p>
    </div>

    <div class="footer-col">
      <p class="footer-heading">Legal</p>
      {legalLinks.map((legal) => (
        <a href={legal.href} class="footer-link">{legal.label}</a>
      ))}
      <button type="button" class="footer-link footer-link-button" id="footer-cookie-prefs-btn">
        Cookie Preferences
      </button>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="copyright">{copyrightText}</p>
  </div>
</footer>

<script>
  var cookiePrefsBtn = document.getElementById('footer-cookie-prefs-btn');
  if (cookiePrefsBtn) {
    cookiePrefsBtn.addEventListener('click', function () {
      if (typeof window.__mtmOpenConsentPreferences === 'function') {
        window.__mtmOpenConsentPreferences();
      }
    });
  }
</script>

<style>
  .site-footer {
    background: var(--rich);
    border-top: 1px solid rgba(248, 250, 252, 0.1);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 3rem 3.5rem;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .logo-line {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
  }

  .tagline {
    font-size: 0.9rem;
    color: rgba(248, 250, 252, 0.62);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 320px;
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(248, 250, 252, 0.18);
    border-radius: 6px;
    color: rgba(248, 250, 252, 0.55);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .social-icon svg {
    width: 16px;
    height: 16px;
  }

  .social-icon:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .footer-heading {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0 0 1.25rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: rgba(248, 250, 252, 0.62);
    text-decoration: none;
    width: fit-content;
  }

  .footer-link:hover {
    color: var(--blue);
  }

  .footer-link-button {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .serving-text {
    font-size: 0.9rem;
    color: rgba(248, 250, 252, 0.62);
    line-height: 1.6;
    margin: 0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(248, 250, 252, 0.1);
    padding: 2rem 3rem;
  }

  .copyright {
    font-size: 0.78rem;
    color: rgba(248, 250, 252, 0.5);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      padding: 3rem 1.5rem 2.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      padding: 1.5rem 1.5rem;
    }
  }
</style>
