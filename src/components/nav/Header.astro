---
import { logoText, navLinks, primaryCta } from '../../data/nav';
---
<header class="site-header" id="site-header">
  <a href="/" class="logo">
    {logoText.main} <span>{logoText.accent}</span>
  </a>

  <nav class="nav-links" aria-label="Primary">
    {navLinks.map((link) => (
      <a href={link.href} class="nav-link">{link.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    <a href={primaryCta.href} target="_blank" rel="noopener" class="nav-cta">
      {primaryCta.label}
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
      id="menu-toggle"
    >
      <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <line x1="5" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <line x1="19" y1="5" x2="5" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-link">{link.label}</a>
    ))}
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (header) {
    const setScrolledState = () => {
      if (window.scrollY > 24) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };

    setScrolledState();
    window.addEventListener('scroll', setScrolledState, { passive: true });
  }

  if (toggle && menu) {
    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
        toggle.focus();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 3rem;
    background: transparent;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    flex-wrap: wrap;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .site-header.is-scrolled {
    background: var(--rich);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .logo {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .logo span {
    color: #fff;
  }

  .nav-links {
    display: flex;
    gap: 2.25rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #fff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-cta {
    background: var(--blue);
    color: #fff;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .nav-cta:hover {
    opacity: 0.87;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
  }

  .menu-toggle svg {
    width: 20px;
    height: 20px;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .mobile-menu {
    display: none;
    width: 100%;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0.25rem 0.5rem;
    margin-top: 1rem;
    background: var(--rich);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0 0 12px 12px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    padding: 0.75rem 0.25rem;
    font-size: 0.98rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    border-radius: 6px;
  }

  .mobile-link:hover,
  .mobile-link:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 860px) {
    .site-header {
      padding: 1.15rem 1.5rem;
    }

    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu:not([hidden]) {
      display: flex;
    }
  }
</style>
