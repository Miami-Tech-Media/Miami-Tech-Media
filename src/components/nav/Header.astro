---
import { logoLines, navLinks, primaryCta } from '../../data/nav';
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Miami Tech Media home">
      {logoLines.join(' ')}
    </a>

    <nav class="nav-links" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a href={primaryCta.href} target="_blank" rel="noopener" class="nav-cta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="cta-icon">
          <rect x="3.5" y="4.5" width="17" height="16" rx="2"/>
          <line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/>
          <line x1="7.5" y1="2.5" x2="7.5" y2="6.5"/>
          <line x1="16.5" y1="2.5" x2="16.5" y2="6.5"/>
        </svg>
        {primaryCta.label}
      </a>

      <button
        type="button"
        class="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        id="menu-toggle"
      >
        <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <line x1="5" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="19" y1="5" x2="5" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-link">{link.label}</a>
      ))}
      <a href={primaryCta.href} target="_blank" rel="noopener" class="mobile-cta">
        {primaryCta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
        toggle.focus();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
  }

  // Discovery Call click tracking. Fires only on an intentional click,
  // does not preventDefault or delay navigation - the link's normal
  // target="_blank" navigation proceeds unchanged. No PII included.
  document.querySelectorAll('.nav-cta, .mobile-cta').forEach((link) => {
    link.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'discovery_call_click', cta_location: 'header' });
    });
  });
</script>

<style>
  .site-header {
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--gray);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 3rem;
    height: 68px;
    flex-wrap: wrap;
  }

  .logo {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rich);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex: 1;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--slate);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:first-child {
    color: var(--blue);
    border-bottom: 2px solid var(--blue);
    padding-bottom: 0.2rem;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--blue);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: #fff;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-size: var(--type-button-size);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .cta-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .nav-cta:hover {
    opacity: 0.88;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--gray);
    border-radius: 6px;
    color: var(--rich);
    cursor: pointer;
  }

  .menu-toggle svg {
    width: 20px;
    height: 20px;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    width: 100%;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--gray);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    padding: 0.75rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--slate);
    text-decoration: none;
    border-radius: 6px;
  }

  .mobile-link:hover,
  .mobile-link:focus-visible {
    color: var(--blue);
    background: var(--light);
  }

  .mobile-cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
    padding: 0.85rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .header-inner {
      padding: 0.85rem 1.5rem;
      height: auto;
      min-height: 64px;
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu:not([hidden]) {
      display: flex;
    }
  }
</style>
